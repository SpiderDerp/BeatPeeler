<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_color"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    tools:context="com.ece420.lab5.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/text_color"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="12dp"
            android:text="@string/init_status"
            android:textColor="@color/text_color"
            android:lines="5" />

        <Button
            android:id="@+id/select_wav_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/accent_color"
            android:onClick="chooseWavFile"
            android:textColor="@color/text_color"
            android:text="Choose WAV File" />

        <TextView
            android:id="@+id/selected_file_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textColor="@color/text_color"
            android:text="Selected file: none" />

        <TextView
            android:id="@+id/window_sec_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_color"
            android:text="Window: 10 sec" />

        <SeekBar
            android:id="@+id/window_sec_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/overlap_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_color"
            android:text="Overlap: 25%" />

        <SeekBar
            android:id="@+id/overlap_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp" />

        <Button
            android:id="@+id/split_song_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Split Song"
            android:onClick="splitSong"
            android:backgroundTint="@color/accent_color"
            android:textColor="@color/text_color"
            android:layout_marginBottom="10dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="Players"
            android:textColor="@color/text_color"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Original"
            android:textColor="@color/text_color"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <ImageButton
                android:id="@+id/original_play_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_media_play"
                android:background="@android:drawable/btn_default"
                android:backgroundTint="@color/accent_color"
                android:tint="@color/text_color"
                android:onClick="toggleOriginalPlayback"
                android:enabled="false" />

            <SeekBar
                android:id="@+id/original_seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:enabled="false" />

            <TextView
                android:id="@+id/original_time_label"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="00:00 / 00:00"
                android:textColor="@color/text_color"
                android:textSize="12sp"
                android:layout_marginRight="8dp" />

            <ImageButton
                android:id="@+id/original_download_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:src="@android:drawable/stat_sys_download_done"
                android:tint="@color/text_color"
                android:background="@drawable/circle_download_button"
                android:onClick="downloadOriginalTrack"
                android:enabled="false" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Background"
            android:textColor="@color/text_color"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <ImageButton
                android:id="@+id/background_play_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_media_play"
                android:background="@android:drawable/btn_default"
                android:backgroundTint="@color/accent_color"
                android:tint="@color/text_color"
                android:onClick="toggleBackgroundPlayback"
                android:enabled="false" />

            <SeekBar
                android:id="@+id/background_seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:enabled="false" />

            <TextView
                android:id="@+id/background_time_label"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="00:00 / 00:00"
                android:textColor="@color/text_color"
                android:textSize="12sp"
                android:layout_marginRight="8dp" />

            <ImageButton
                android:id="@+id/background_download_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:src="@android:drawable/stat_sys_download_done"
                android:tint="@color/text_color"
                android:background="@drawable/circle_download_button"
                android:onClick="downloadBackgroundTrack"
                android:enabled="false" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Foreground"
            android:textColor="@color/text_color"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <ImageButton
                android:id="@+id/foreground_play_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_media_play"
                android:background="@android:drawable/btn_default"
                android:backgroundTint="@color/accent_color"
                android:tint="@color/text_color"
                android:onClick="toggleForegroundPlayback"
                android:enabled="false" />

            <SeekBar
                android:id="@+id/foreground_seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:enabled="false" />

            <TextView
                android:id="@+id/foreground_time_label"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="00:00 / 00:00"
                android:textColor="@color/text_color"
                android:textSize="12sp"
                android:layout_marginRight="8dp" />

            <ImageButton
                android:id="@+id/foreground_download_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:src="@android:drawable/stat_sys_download_done"
                android:tint="@color/text_color"
                android:background="@drawable/circle_download_button"
                android:onClick="downloadForegroundTrack"
                android:enabled="false" />
        </LinearLayout>
    </LinearLayout>

</ScrollView>

